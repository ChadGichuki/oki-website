# Resend API key (https://resend.com/api-keys). The sending domain must be verified in Resend.
RESEND_API_KEY=
# Inbox that receives contact form enquiries.
CONTACT_TO_EMAIL=info@okidigital.co.ke
# Plausible site domain. Read at build time: changing it needs a redeploy.
PLAUSIBLE_DOMAIN=okidigital.co.ke
